# ============================================================
#  Ye file ko COPY karke  secrets/.env  me save karein:
#     mkdir -p secrets && cp .env.example secrets/.env
#  Phir niche khali jagahon me apni values likhein.
#  ⚠️ Ye file kabhi GitHub par upload na karein (gitignore me hai).
# ============================================================

# --- Script generation ---
# gemini = free (recommended) | openai = paid
LLM_PROVIDER=gemini

# Gemini free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI key (sirf tab jab LLM_PROVIDER=openai): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- YouTube upload (Google Cloud project se) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
